# Hostinger (LiteSpeed / Apache): single-page app routing for React Router (BrowserRouter).
# Real files and folders (send-email.php, robots.txt, sitemap.xml, /assets, sw.js...) are
# served as-is. "/" is index.html (home page prerendered at build time); every other path
# (/portfolio, /blog/mon-article...) gets the empty app shell app.html.
Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS and the bare domain so only one version gets indexed
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://willydev.online%{REQUEST_URI} [L,R=301]

  # The projects page moved to /portfolio
  RewriteRule ^projets/?$ /portfolio [L,R=301]

  # Images uploaded from /admin are stored outside public_html (see api/image.php)
  RewriteRule ^uploads/(\d{4}/\d{2}/[a-z0-9-]+\.(?:jpg|png|webp|gif))$ api/image.php?f=$1 [L]

  RewriteRule ^(index|app)\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing static files stay 404 instead of returning the app
  RewriteRule ^assets/ - [L,R=404]

  RewriteRule ^ app.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Always revalidate the HTML so a new deploy is picked up
  <FilesMatch "^(index\.html|app\.html|sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Vite build files have a content hash in their name (index-CLJeLRFq.js):
  # a new version always gets a new name, so they can be cached for a year
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
